# =============================================================================
# EssentiaMES - configurazione (copiare in .env.local per sviluppo, oppure
# impostare come variabili d'ambiente / env_file di Docker in produzione)
# =============================================================================

# --- Database SQL Server (lo stesso usato dalla vecchia applicazione) --------
DB_SERVER=192.168.1.10          # host/IP del server SQL (via VPN/Tailscale se l'app e' fuori azienda)
DB_PORT=1433
# DB_INSTANCE=SQLEXPRESS        # istanza con nome (usa SQL Browser, UDP 1434): in alternativa a DB_PORT
DB_NAME=Brighetti
DB_USER=essentia_app            # login SQL dedicato (consigliato) ...
DB_PASSWORD=cambiami
# DB_AUTH_TYPE=ntlm             # ... oppure autenticazione Windows di dominio
# DB_DOMAIN=AZIENDA
DB_ENCRYPT=true                 # cifratura TLS verso SQL Server (consigliata fuori dalla LAN)
DB_TRUST_SERVER_CERTIFICATE=false  # true solo se SQL Server usa un certificato autofirmato
# DB_CONNECTION_STRING=Server=srv,1433;Database=Brighetti;User Id=...;Password=...;Encrypt=true
# DB_POOL_MAX=10

# --- Applicazione ------------------------------------------------------------
# Segreto per firmare le sessioni: stringa casuale di almeno 32 caratteri
# (es. `openssl rand -base64 48`). OBBLIGATORIO in produzione.
SESSION_SECRET=
SESSION_HOURS=12
TZ=Europe/Rome                  # le date nel DB sono in ora italiana: NON cambiare
# COOKIE_SECURE=true            # default true in produzione (richiede HTTPS)
# APP_URL=https://mes.azienda.it   # origini ammesse per le richieste (dietro reverse proxy)
# LOGIN_LOCKOUT=true            # blocco account dopo 5 tentativi falliti per 5 minuti

# --- Documenti allegati -------------------------------------------------------
UPLOAD_DIR=./data/upload_documenti
# LEGACY_UPLOAD_DIRS=/mnt/vecchio/upload_documenti   # cartelle dove cercare i file del vecchio software
MAX_UPLOAD_MB=50

# --- Automazioni ---------------------------------------------------------------
SCHEDULER_ENABLED=true          # false su istanze aggiuntive o se si usa un cron esterno
CRON_SECRET=                    # token per /api/cron/<job> (Authorization: Bearer ...)

# --- Email richieste materiali (facoltativo) ------------------------------------
# SMTP_HOST=smtp.azienda.it
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@azienda.it
# SMTP_PASSWORD=
# SMTP_FROM=noreply@azienda.it
# SMTP_RICHIESTE_MATERIALI_TO=magazzino@azienda.it

# DOCS_URL=https://...          # link "Documentazione Essentia" nella pagina Account ('' per nasconderlo)
